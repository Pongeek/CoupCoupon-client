# Database
DB_URL=jdbc:mysql://localhost:3306/coupcoupon?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=your_password_here

# JWT - Generate a strong Base64-encoded secret (minimum 256 bits)
# Example: openssl rand -base64 32
JWT_SECRET=your_base64_encoded_secret_here
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# CORS (comma-separated for prod)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
